{
  "manifest_version": 3,
  "name": "Cue · 网页视频语言学习",
  "short_name": "Cue",
  "version": "0.3.1",
  "description": "在网页视频中同步字幕、学习表达并收藏到本地词库。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://api.dictionaryapi.dev/*",
    "https://api.mymemory.translated.net/*",
    "https://api.bilibili.com/*",
    "https://*.hdslb.com/*",
    "https://*.iqiyi.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "点击在网页视频中开启 Cue",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
